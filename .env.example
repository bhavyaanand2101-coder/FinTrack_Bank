# ==============================================================================
# FinTrack – Smart Digital Banking & Loan Management System
# Production & Development Environment Variable Template
# ==============================================================================

# 1. Primary Relational Database (PostgreSQL 16)
# Local, Docker, Neon.tech, Supabase, or AWS RDS connection URI
POSTGRES_URI=postgresql://fintrack_user:fintrack_password@localhost:5432/fintrack

# 2. Secondary Audit Database (MongoDB 7.0 Community / Atlas)
# Append-only security event and outbox audit log store
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=fintrack_db

# 3. PostgreSQL Thread-Safe Connection Pool
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT_SECONDS=10

# 4. Deterministic Compliance & Anti-Money Laundering Threshold
# Any transfer >= this amount (in INR) is held for administrative escrow review
FRAUD_THRESHOLD=10000.00

# 5. Application Security & JWT Configuration
# Cryptographic secret key used to sign HMAC-SHA256 JWT tokens (min 32 characters)
SECRET_KEY=fintrack-production-secure-master-key-2026-sha256-deterministic
# Active token session validity period
SESSION_TIMEOUT_MINUTES=30

# 6. Live Excel Spreadsheet Workbook Path (Optional)
# Target file path for the real-time background sync daemon
LIVE_EXCEL_PATH=fintrack_live_data.xlsx

# 7. Frontend API Configuration (for frontend/.env)
# In production behind Nginx reverse proxy, leave as /api
# In separate local dev servers, set to http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api
