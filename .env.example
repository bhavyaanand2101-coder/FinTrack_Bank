# FinTrack – Smart Digital Banking & Loan Management System
# Environment Configuration Template

# PostgreSQL Database Connection
# Neon.tech, Supabase, or local PostgreSQL URL
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/fintrack?sslmode=prefer

# MongoDB Atlas Connection (Optional for local testing; transactional outbox handles fallback gracefully)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=fintrack_db

# Connection Pool Configuration
DB_POOL_MIN=1
DB_POOL_MAX=10

# AI/ML & Rule-based Fraud Detection
FRAUD_THRESHOLD=10000.00
Z_SCORE_THRESHOLD=3.0

# Session & Security
SESSION_TIMEOUT_MINUTES=30
SECRET_KEY=change-this-in-production-to-a-secure-random-string-at-least-32-chars

