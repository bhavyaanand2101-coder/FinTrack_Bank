# ==============================================================================
# FinTrack Docker Compose Environment Configuration
# ==============================================================================

# Port Mappings (Host : Container)
PORT_FRONTEND=8080
PORT_BACKEND=8001
PORT_POSTGRES=5433
PORT_MONGO=27018

# Security & Secrets
SECRET_KEY=generate_a_secure_random_64_character_string_for_production
FRAUD_THRESHOLD=10000.00
SESSION_TIMEOUT_MINUTES=30

# Database Credentials
POSTGRES_USER=fintrack_user
POSTGRES_PASSWORD=fintrack_password
POSTGRES_DB=fintrack
MONGO_INITDB_DATABASE=fintrack_db
